<script>
(function () {
  var SPW = {
    csrfToken: <?=json_encode($csrfToken)?>,
    scanUrl: '/plugins/supla-pwr-unraid/scripts/scan.php',
    saveUrl: '/plugins/supla-pwr-unraid/scripts/save.php',
  };

  function $(id) { return document.getElementById(id); }

  // Bezpieczny fetch->JSON: jeśli serwer nie zwróci poprawnego JSON (np.
  // przekierowanie do loginu po wygaśnięciu sesji, 403 CSRF), pokazuje
  // dokładny status/treść zamiast kryptycznego "Unexpected end of JSON input".
  function spwFetchJson(url, opts) {
    opts = opts || {};
    // webGUI (auto_prepend_file) wymaga tokena CSRF dla kazdego POST - przy JSON body
    // $_POST jest puste, wiec token trzeba wyslac jako naglowek X-Csrf-Token.
    if ((opts.method || 'GET').toUpperCase() === 'POST') {
      opts.headers = Object.assign({ 'X-Csrf-Token': SPW.csrfToken }, opts.headers || {});
    }
    return fetch(url, opts).then(function (r) {
      return r.text().then(function (text) {
        if (!text) {
          throw new Error('Pusta odpowiedź serwera (HTTP ' + r.status + '). Sesja WebGUI mogła wygasnąć — odśwież stronę i zaloguj się ponownie.');
        }
        try {
          return JSON.parse(text);
        } catch (e) {
          if (/<html|<!doctype/i.test(text)) {
            throw new Error('Serwer zwrócił stronę HTML zamiast danych (HTTP ' + r.status + ') — prawdopodobnie wygasła sesja WebGUI. Odśwież stronę i zaloguj się ponownie.');
          }
          throw new Error('Nieprawidłowa odpowiedź serwera (HTTP ' + r.status + '): ' + text.slice(0, 200));
        }
      });
    });
  }

  function showStatus(ok, msg) {
    var el = $('spw-status');
    el.className = 'spw-status ' + (ok ? 'ok' : 'err');
    el.textContent = msg;
  }

  function fmt(v, d) {
    d = d === undefined ? 1 : d;
    return (v === null || v === undefined) ? '—' : Number(v).toFixed(d);
  }

  function renderPreview(d) {
    var box = $('spw-preview');
    box.className = 'spw-preview show';
    box.innerHTML =
      '<div class="spw-stat"><div class="num">' + fmt(d.power, 1) + ' W</div><div class="lbl">Moc</div></div>' +
      '<div class="spw-stat"><div class="num">' + fmt(d.voltage, 1) + ' V</div><div class="lbl">Napięcie</div></div>' +
      '<div class="spw-stat"><div class="num">' + fmt(d.current, 2) + ' A</div><div class="lbl">Prąd</div></div>' +
      '<div class="spw-stat"><div class="num">' + fmt(d.energy, 2) + ' kWh</div><div class="lbl">Zużycie</div></div>' +
      '<div class="spw-stat"><div class="num">' + fmt(d.factor, 1) + ' %</div><div class="lbl">Cos φ</div></div>' +
      '<div class="spw-stat"><div class="num">' + fmt(d.cost, 2) + ' ' + (d.currency || '') + '</div><div class="lbl">Koszt</div></div>';
  }

  // --- Zapis ustawień ---
  $('spw-save').addEventListener('click', function () {
    var payload = {
      device_url: $('spw-url').value.trim(),
      uirefresh: $('spw-refresh').value.trim() || '10',
      price_override: $('spw-price').value.trim(),
      csrf_token: SPW.csrfToken,
    };
    spwFetchJson(SPW.saveUrl, { method: 'POST', body: JSON.stringify(payload) })
      .then(function (d) {
        showStatus(!!d.ok, d.ok ? 'Zapisano ustawienia.' : (d.error || 'Błąd zapisu.'));
      })
      .catch(function (e) { showStatus(false, e.message || String(e)); });
  });

  // --- Test połączenia (odczyt na żywo z aktualnych pól, nie z zapisanej konfiguracji) ---
  $('spw-test').addEventListener('click', function () {
    showStatus(true, 'Łączenie…');
    $('spw-preview').className = 'spw-preview';
    // Zapisz najpierw aktualne pola, żeby scan.php (który czyta z zapisanej konfiguracji) widział to co testujemy.
    var payload = {
      device_url: $('spw-url').value.trim(),
      uirefresh: $('spw-refresh').value.trim() || '10',
      price_override: $('spw-price').value.trim(),
      csrf_token: SPW.csrfToken,
    };
    spwFetchJson(SPW.saveUrl, { method: 'POST', body: JSON.stringify(payload) })
      .then(function () { return spwFetchJson(SPW.scanUrl); })
      .then(function (d) {
        if (!d.ok) { showStatus(false, d.error); return; }
        showStatus(true, 'Połączono — odczyt na żywo poniżej.');
        renderPreview(d.data);
      })
      .catch(function (e) { showStatus(false, e.message || String(e)); });
  });
})();
</script>
